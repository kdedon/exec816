SetSignal(newSignals,signalSet)(ULONG,ULONG) ULONG
SetExcept(newSignals,signalSet)(d0/d1)
Wait(signalSet)(ULONG) ULONG
Signal(task,signalSet)(struct Task *,ULONG) void
AllocSignal(signalNum)(int) int
FreeSignal(signalNum)(int) void
AllocTrap(trapNum)(d0)
FreeTrap(trapNum)(d0)
*------ messages -----------------------------------------------------
